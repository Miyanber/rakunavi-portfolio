# ========================================================
# RakuNavi - Portfolio Environment Configuration Template
# ========================================================
# Copy this file to '.env' or '.env.development' for local development.

# Django Security Key (Change this in production)
SECRET_KEY=django-insecure-portfolio-sample-secret-key-change-me

# Debug Mode (True for local development, False for production)
DEBUG=True

# Environment Mode ('development' uses local SQLite3 database)
ENVIRONMENT=development

# Allowed Hosts (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (Comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Site ID for django.contrib.sites
SITE_ID=1

# Cloud Deployment Flag
DEPLOY_DONE=False

# Optional Production Settings (Not required for local development):
# CLOUD_SERVICE=aws
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=ap-northeast-1
# CDN_DOMAIN=static.example.com
